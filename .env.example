# Copy to backend/.env for local development.
DATABASE_URL=postgres://campus:campus_dev@localhost/campus
BIND=127.0.0.1:8080
STATIC_DIR=../web/dist
# Set both when serving over HTTPS behind a proxy you control:
SECURE_COOKIES=false
TRUST_PROXY=false
# Comma-separated extra origins allowed to make changes (e.g. a separate admin host).
ALLOWED_ORIGINS=
# Load the Northfield Academy demo school into an empty database.
SEED_DEMO=1
